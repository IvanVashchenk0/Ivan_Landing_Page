VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser
# Required for production builds; leave unset for local-original development.
# VITE_MEDIA_BASE_URL=https://media.example.com
# VITE_USE_LOCAL_MEDIA=true

# GitHub Pages option: VITE_BASE_PATH=/REPOSITORY/ and VITE_ROUTER_MODE=hash
# Upload settings belong in ignored .env.media.local or an AWS CLI profile:
# MEDIA_BUCKET=your-bucket
# MEDIA_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# MEDIA_REGION=auto
# AWS_PROFILE=your-media-profile
# Never prefix upload credentials with VITE_.

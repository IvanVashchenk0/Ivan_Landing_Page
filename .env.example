VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser
# Public URL only. Replace this example after connecting your R2 custom domain.
# Leave unset in local development to use media-source/.
VITE_MEDIA_BASE_URL=https://media.example.com
# VITE_USE_LOCAL_MEDIA=true

# Script-only config belongs in ignored .env.media.local:
# R2_BUCKET, R2_ENDPOINT, R2_REGION, R2_AWS_PROFILE, R2_PUBLIC_BASE_URL
# Credentials belong in the AWS CLI profile: aws configure --profile ivan-r2
# Never use VITE_ variables for upload credentials.
